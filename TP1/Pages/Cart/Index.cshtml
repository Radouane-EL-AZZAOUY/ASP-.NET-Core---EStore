@page
@model TP1.Pages.Cart.IndexModel

@{
    ViewData["Title"] = "Shopping Cart";
}

@section Styles {
    <style>
        body {
            background: #f5f5f5;
        }

        .cart-container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 30px 20px 50px;
        }

        .cart-header {
            margin-bottom: 30px;
            padding-bottom: 20px;
            border-bottom: 2px solid #e5e5e5;
        }

        .cart-header-title {
            font-size: 32px;
            font-weight: 600;
            margin: 0 0 8px 0;
            color: #232f3e;
        }

        .cart-header-subtitle {
            font-size: 15px;
            color: #767676;
            font-weight: 400;
        }

        .cart-main-content {
            display: flex;
            gap: 20px;
            align-items: flex-start;
        }

        .cart-items-section {
            flex: 1;
            background: white;
            border-radius: 8px;
            padding: 24px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        }

        .cart-item {
            padding: 20px 0;
            border-bottom: 1px solid #e5e5e5;
            display: flex;
            gap: 20px;
            align-items: flex-start;
        }

        .cart-item:last-child {
            border-bottom: none;
        }

        .cart-item-image-wrapper {
            flex-shrink: 0;
            width: 180px;
            height: 180px;
            background: #f8f9fa;
            border-radius: 8px;
            padding: 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px solid #e5e5e5;
        }

        .cart-item-image {
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
        }

        .cart-item-details {
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .cart-item-title {
            font-size: 18px;
            font-weight: 600;
            color: #232f3e;
            line-height: 1.4;
            margin-bottom: 4px;
        }

        .cart-item-price {
            font-size: 22px;
            color: #cc0c39;
            font-weight: 700;
        }

        .cart-item-stock {
            font-size: 13px;
            color: #007600;
            font-weight: 500;
        }

        .cart-item-shipping {
            font-size: 13px;
            color: #007185;
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .cart-item-quantity-section {
            display: flex;
            align-items: center;
            gap: 15px;
            margin-top: 12px;
        }

        .quantity-label {
            font-size: 13px;
            color: #565959;
            font-weight: 500;
        }

        .quantity-controls {
            display: inline-flex;
            align-items: center;
            gap: 0;
            border: 1px solid #d5d9d9;
            border-radius: 8px;
            overflow: hidden;
            background: white;
        }

        .quantity-btn {
            background: white;
            border: none;
            border-right: 1px solid #d5d9d9;
            padding: 8px 14px;
            cursor: pointer;
            font-size: 16px;
            font-weight: 600;
            color: #232f3e;
            transition: background 0.2s;
        }

        .quantity-btn:last-child {
            border-right: none;
            border-left: 1px solid #d5d9d9;
        }

        .quantity-btn:hover {
            background: #f7f8f8;
        }

        .quantity-display {
            padding: 8px 16px;
            font-size: 15px;
            font-weight: 600;
            color: #232f3e;
            min-width: 45px;
            text-align: center;
        }

        .cart-item-actions {
            display: flex;
            gap: 15px;
            margin-top: 10px;
        }

        .action-link {
            background: transparent;
            color: #007185;
            border: none;
            padding: 0;
            cursor: pointer;
            font-size: 13px;
            font-weight: 500;
            text-decoration: none;
        }

        .action-link:hover {
            text-decoration: underline;
            color: #c7511f;
        }

        .action-separator {
            color: #ddd;
        }

        .cart-item-subtotal {
            flex-shrink: 0;
            text-align: right;
            padding-left: 20px;
        }

        .subtotal-label {
            font-size: 13px;
            color: #565959;
            margin-bottom: 4px;
        }

        .subtotal-price {
            font-size: 22px;
            font-weight: 700;
            color: #232f3e;
        }

        .cart-summary-sidebar {
            width: 320px;
            flex-shrink: 0;
        }

        .cart-summary {
            background: white;
            border-radius: 8px;
            padding: 24px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.08);
            position: sticky;
            top: 20px;
        }

        .summary-title {
            font-size: 18px;
            font-weight: 600;
            color: #232f3e;
            margin: 0 0 20px 0;
        }

        .free-shipping-banner {
            background: linear-gradient(135deg, #e8f5e9 0%, #c8e6c9 100%);
            border-left: 4px solid #4caf50;
            padding: 12px;
            border-radius: 6px;
            margin-bottom: 20px;
        }

        .free-shipping-text {
            font-size: 13px;
            color: #1b5e20;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .summary-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 12px;
            font-size: 15px;
            color: #565959;
        }

        .summary-row-value {
            font-weight: 600;
            color: #232f3e;
        }

        .summary-divider {
            height: 1px;
            background: #e5e5e5;
            margin: 16px 0;
        }

        .summary-total {
            display: flex;
            justify-content: space-between;
            font-size: 20px;
            font-weight: 700;
            color: #232f3e;
            padding-top: 8px;
        }

        .summary-total-value {
            color: #cc0c39;
        }

        .checkout-btn {
            width: 100%;
            background: linear-gradient(to bottom, #f7dfa5, #f0c14b);
            border: 1px solid #a88734;
            border-radius: 8px;
            padding: 14px;
            font-size: 16px;
            font-weight: 600;
            color: #111;
            cursor: pointer;
            margin-top: 20px;
            box-shadow: 0 2px 5px rgba(213,217,217,.5);
            transition: all 0.2s;
        }

        .checkout-btn:hover {
            background: linear-gradient(to bottom, #f5d78e, #edb932);
            box-shadow: 0 3px 8px rgba(213,217,217,.8);
        }

        .continue-shopping-link {
            display: block;
            text-align: center;
            margin-top: 15px;
            color: #007185;
            text-decoration: none;
            font-size: 14px;
            font-weight: 500;
        }

        .continue-shopping-link:hover {
            text-decoration: underline;
            color: #c7511f;
        }

        .empty-cart {
            text-align: center;
            padding: 80px 20px;
            background: white;
            border-radius: 8px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        }

        .empty-cart-icon {
            font-size: 80px;
            margin-bottom: 24px;
            opacity: 0.5;
        }

        .empty-cart-title {
            font-size: 28px;
            font-weight: 600;
            color: #232f3e;
            margin-bottom: 12px;
        }

        .empty-cart-text {
            font-size: 16px;
            color: #565959;
            margin-bottom: 30px;
        }

        .start-shopping-btn {
            display: inline-block;
            padding: 14px 32px;
            background: linear-gradient(to bottom, #f7dfa5, #f0c14b);
            border: 1px solid #a88734;
            color: #111;
            text-decoration: none;
            border-radius: 8px;
            font-size: 16px;
            font-weight: 600;
            box-shadow: 0 2px 5px rgba(213,217,217,.5);
            transition: all 0.2s;
        }

        .start-shopping-btn:hover {
            background: linear-gradient(to bottom, #f5d78e, #edb932);
            box-shadow: 0 3px 8px rgba(213,217,217,.8);
            color: #111;
        }

        @@media (max-width: 992px) {
            .cart-main-content {
                flex-direction: column;
            }

            .cart-summary-sidebar {
                width: 100%;
            }
        }
    </style>
}

<div class="cart-container">
    <div class="cart-header">
        <h1 class="cart-header-title">Shopping Cart</h1>
        @if (Model.CartItems != null && Model.CartItems.Any())
        {
            <div class="cart-header-subtitle">
                @Model.CartItems.Sum(x => x.Quantity) items in your cart
            </div>
        }
    </div>

    @if (Model.CartItems != null && Model.CartItems.Any())
    {
        <div class="cart-main-content">
            <div class="cart-items-section">
                @foreach (var item in Model.CartItems)
                {
                    <div class="cart-item">
                        <div class="cart-item-image-wrapper">
                            <img src="@(item.ImagePath ?? "/images/placeholder.jpg")" alt="@item.ProductTitle" class="cart-item-image" />
                        </div>
                        <div class="cart-item-details">
                            <div class="cart-item-title">@item.ProductTitle</div>
                            <div class="cart-item-price">$@item.Price.ToString("F2")</div>
                            <div class="cart-item-stock">✓ In Stock</div>
                            <div class="cart-item-shipping">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M16 3h5v13h-5zM2 8h11v8H2z"/>
                                    <circle cx="5.5" cy="18.5" r="2.5"/>
                                    <circle cx="18.5" cy="18.5" r="2.5"/>
                                </svg>
                                Eligible for FREE Shipping
                            </div>
                            <div class="cart-item-quantity-section">
                                <span class="quantity-label">Qty:</span>
                                <form method="post" asp-page-handler="UpdateQuantity" style="display: inline;">
                                    <input type="hidden" name="productId" value="@item.ProductId" />
                                    <div class="quantity-controls">
                                        <button type="submit" name="action" value="decrease" class="quantity-btn">-</button>
                                        <span class="quantity-display">@item.Quantity</span>
                                        <button type="submit" name="action" value="increase" class="quantity-btn">+</button>
                                    </div>
                                </form>
                            </div>
                            <div class="cart-item-actions">
                                <form method="post" asp-page-handler="RemoveItem" style="display: inline;">
                                    <input type="hidden" name="productId" value="@item.ProductId" />
                                    <button type="submit" class="action-link">Delete</button>
                                </form>
                            </div>
                        </div>
                        <div class="cart-item-subtotal">
                            <div class="subtotal-label">Subtotal</div>
                            <div class="subtotal-price">$@item.Total.ToString("F2")</div>
                        </div>
                    </div>
                }
            </div>
            
            <div class="cart-summary-sidebar">
                <div class="cart-summary">
                    <div class="free-shipping-banner">
                        <div class="free-shipping-text">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="20 6 9 17 4 12"></polyline>
                            </svg>
                            Your order qualifies for FREE Shipping
                        </div>
                    </div>
                    
                    <h3 class="summary-title">Order Summary</h3>
                    
                    <div class="summary-row">
                        <span>Items (@Model.CartItems.Count):</span>
                        <span class="summary-row-value">$@Model.Subtotal.ToString("F2")</span>
                    </div>
                    <div class="summary-row">
                        <span>Shipping & handling:</span>
                        <span class="summary-row-value" style="color: #007600;">FREE</span>
                    </div>
                    
                    <div class="summary-divider"></div>
                    
                    <div class="summary-total">
                        <span>Order Total:</span>
                        <span class="summary-total-value">$@Model.Total.ToString("F2")</span>
                    </div>
                    
                    <form method="post" asp-page-handler="Checkout">
                        <button type="submit" class="checkout-btn">Proceed to Checkout (@Model.CartItems.Count items)</button>
                    </form>
                    
                    <a asp-page="/Products/Index" class="continue-shopping-link">← Continue Shopping</a>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="empty-cart">
            <div class="empty-cart-icon">🛒</div>
            <h2 class="empty-cart-title">Your Shopping Cart is Empty</h2>
            <p class="empty-cart-text">Looks like you haven't added any items to your cart yet. Start shopping now!</p>
            <a asp-page="/Products/Index" class="start-shopping-btn">Start Shopping</a>
        </div>
    }
</div>

