@page
@model TP1.Pages.Products.DetailsModel

@{
    ViewData["Title"] = Model.Product.Title;
}

@section Styles {
    <style>
        .product-detail-container {
            background: white;
            border-radius: 8px;
            padding: 20px;
            margin-top: 20px;
        }

        .breadcrumb-nav {
            font-size: 13px;
            color: #565959;
            margin-bottom: 20px;
        }

        .breadcrumb-nav a {
            color: #007185;
            text-decoration: none;
        }

        .breadcrumb-nav a:hover {
            color: #C7511F;
            text-decoration: underline;
        }

        .product-detail-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 40px;
            margin-bottom: 30px;
        }

        .product-image-section {
            position: sticky;
            top: 20px;
            height: fit-content;
        }

        .product-main-image {
            width: 100%;
            max-height: 500px;
            object-fit: contain;
            border: 1px solid #ddd;
            border-radius: 8px;
            padding: 20px;
            background: #f8f9fa;
        }

        .product-info-section h1 {
            font-size: 24px;
            font-weight: 400;
            color: #0F1111;
            margin-bottom: 8px;
            line-height: 1.3;
        }

        .product-rating {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 12px;
            font-size: 14px;
        }

        .rating-stars {
            color: #FFA41C;
        }

        .product-price-box {
            background: #f0f2f2;
            padding: 16px;
            border-radius: 8px;
            margin: 20px 0;
        }

        .product-price {
            font-size: 28px;
            color: #B12704;
            font-weight: 400;
        }

        .price-currency {
            font-size: 13px;
            vertical-align: super;
        }

        .product-stock {
            font-size: 18px;
            margin-top: 8px;
        }

        .product-stock.in-stock {
            color: #067D62;
        }

        .product-stock.out-stock {
            color: #B12704;
        }

        .product-description {
            margin: 24px 0;
        }

        .product-description h3 {
            font-size: 16px;
            font-weight: 700;
            color: #0F1111;
            margin-bottom: 12px;
        }

        .product-description p {
            font-size: 14px;
            color: #0F1111;
            line-height: 1.6;
        }

        .product-features {
            margin: 24px 0;
        }

        .product-features h3 {
            font-size: 16px;
            font-weight: 700;
            color: #0F1111;
            margin-bottom: 12px;
        }

        .feature-list {
            list-style: none;
            padding: 0;
        }

        .feature-list li {
            padding: 8px 0;
            border-bottom: 1px solid #e7e7e7;
            font-size: 14px;
            display: flex;
            justify-content: space-between;
        }

        .feature-list li:last-child {
            border-bottom: none;
        }

        .feature-label {
            color: #565959;
            font-weight: 500;
        }

        .feature-value {
            color: #0F1111;
        }

        .action-buttons {
            display: flex;
            gap: 12px;
            margin-top: 24px;
        }

        .btn-add-cart {
            flex: 1;
            background-color: #FFD814;
            border: 1px solid #FCD200;
            color: #0F1111;
            padding: 12px 24px;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 500;
            cursor: pointer;
            transition: background-color 0.2s;
        }

        .btn-add-cart:hover {
            background-color: #F7CA00;
        }

        .btn-buy-now {
            flex: 1;
            background-color: #FFA41C;
            border: 1px solid #FF8F00;
            color: #0F1111;
            padding: 12px 24px;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 500;
            cursor: pointer;
            transition: background-color 0.2s;
        }

        .btn-buy-now:hover {
            background-color: #FA8900;
        }

        .admin-actions {
            margin-top: 30px;
            padding-top: 20px;
            border-top: 1px solid #e7e7e7;
        }

        .admin-actions a {
            color: #007185;
            text-decoration: none;
            margin-right: 16px;
            font-size: 14px;
        }

        .admin-actions a:hover {
            color: #C7511F;
            text-decoration: underline;
        }

        @@media (max-width: 768px) {
            .product-detail-grid {
                grid-template-columns: 1fr;
                gap: 20px;
            }

            .product-image-section {
                position: static;
            }
        }
    </style>
}

<div class="product-detail-container">
    <div class="breadcrumb-nav">
        <a asp-page="/Index">Home</a> › 
        <a asp-page="/Products/Index">Products</a> › 
        <span>@Model.Product.Title</span>
    </div>

    <div class="product-detail-grid">
        <!-- Product Image Section -->
        <div class="product-image-section">
            @if (!string.IsNullOrEmpty(Model.Product.MainImagePath))
            {
                <img src="@Model.Product.MainImagePath" alt="@Model.Product.Title" class="product-main-image" />
            }
            else
            {
                <div class="product-main-image d-flex align-items-center justify-content-center" style="min-height: 400px;">
                    <span class="text-muted">No image available</span>
                </div>
            }
        </div>

        <!-- Product Info Section -->
        <div class="product-info-section">
            <h1>@Model.Product.Title</h1>

            <div class="product-rating">
                <span class="rating-stars">★★★★☆</span>
                <span class="text-muted">4.5 out of 5</span>
            </div>

            <div class="product-price-box">
                <div class="product-price">
                    <span class="price-currency">$</span>@Model.Product.Price.ToString("N2")
                </div>
                <div class="product-stock @(Model.Product.Quantity > 0 ? "in-stock" : "out-stock")">
                    @if (Model.Product.Quantity > 0)
                    {
                        <span>✓ In Stock</span>
                        @if (Model.Product.Quantity < 10)
                        {
                            <span class="text-muted" style="font-size: 14px;"> - Only @Model.Product.Quantity left!</span>
                        }
                    }
                    else
                    {
                        <span>✗ Currently Unavailable</span>
                    }
                </div>
            </div>

            <div class="product-description">
                <h3>About this item</h3>
                <p>@Model.Product.Description</p>
            </div>

            <div class="product-features">
                <h3>Product Details</h3>
                <ul class="feature-list">
                    <li>
                        <span class="feature-label">Price</span>
                        <span class="feature-value">$@Model.Product.Price.ToString("N2")</span>
                    </li>
                    <li>
                        <span class="feature-label">Availability</span>
                        <span class="feature-value">@(Model.Product.Quantity > 0 ? "In Stock" : "Out of Stock")</span>
                    </li>
                    <li>
                        <span class="feature-label">Added</span>
                        <span class="feature-value">@Model.Product.AddedAt.ToString("MMMM dd, yyyy")</span>
                    </li>
                    <li>
                        <span class="feature-label">Last Updated</span>
                        <span class="feature-value">@Model.Product.UpdatedAt.ToString("MMMM dd, yyyy")</span>
                    </li>
                </ul>
            </div>

            @if (Model.Product.Quantity > 0)
            {
                <div class="action-buttons">
                    <button class="btn-add-cart" onclick="addToCart(@Model.Product.Id)">
                        🛒 Add to Cart
                    </button>
                    <button class="btn-buy-now" onclick="buyNow(@Model.Product.Id)">
                        ⚡ Buy Now
                    </button>
                </div>
            }
            else
            {
                <div class="alert alert-warning mt-3">
                    This item is currently out of stock. Check back later or browse similar products.
                </div>
            }

            <div class="admin-actions">
                <a asp-page="./Edit" asp-route-id="@Model.Product.Id">✏️ Edit Product</a>
                <a asp-page="./Delete" asp-route-id="@Model.Product.Id">🗑️ Delete Product</a>
                <a asp-page="./Index">← Back to Products</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function addToCart(productId) {
            // Add to cart functionality
            alert('Product added to cart! (Feature to be implemented)');
        }

        function buyNow(productId) {
            // Buy now functionality
            alert('Proceeding to checkout... (Feature to be implemented)');
        }
    </script>
}
